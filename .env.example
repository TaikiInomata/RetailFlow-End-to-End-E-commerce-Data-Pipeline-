# =========================================================
# DOCKER COMPOSE CONFIG - RetailFlow Data Pipeline
# =========================================================

# --- POSTGRES ---
POSTGRES_IMAGE=postgres:15-alpine   # Image PostgreSQL (alpine = bản nhẹ)
DB_HOST=localhost
DB_USER=retailflowUser              # Tên user đăng nhập database
DB_PASSWORD=retailflowPassword      # Mật khẩu database (dùng mật khẩu mạnh hơn ở production)
DB_NAME=retailflowDb                # Tên database được tạo khi container khởi động lần đầu
DB_PORT=5433                        # Port host expose ra ngoài (dùng 5433 tránh conflict với PG local)
PG_MAX_WAL_SENDERS=3               # Số kết nối replication đồng thời tối đa (cho Debezium CDC)
PG_MAX_REPLICATION_SLOTS=3         # Số slot replication tối đa (mỗi Debezium connector cần 1 slot)
PG_WAL_KEEP_SIZE=256               # Giữ tối thiểu 256MB WAL, tránh mất data khi client ngắt tạm thời

# --- ZOOKEEPER ---
ZOOKEEPER_IMAGE=confluentinc/cp-zookeeper:7.4.4  # Image Zookeeper (Confluent)
ZOOKEEPER_PORT=2181                 # Port HOST expose ra ngoài (dùng để debug/monitor từ máy local)
ZOOKEEPER_TICK_TIME=2000            # Đơn vị thời gian cơ bản (ms), dùng để tính heartbeat và session timeout

# --- KAFKA ---
KAFKA_IMAGE=confluentinc/cp-kafka:7.4.4  # Image Kafka (phải cùng version với Zookeeper)
KAFKA_PORT=9092                     # Port HOST expose ra ngoài cho producer/consumer bên ngoài Docker
KAFKA_BROKER_ID=1                   # ID định danh broker trong cluster (phải unique, single-broker thì luôn là 1)
KAFKA_REPLICATION_FACTOR=1          # Số bản sao cho internal topics (=1 cho dev single-broker, =3 ở production cluster)
KAFKA_REBALANCE_DELAY=0             # Delay (ms) trước khi rebalance consumer group khi broker khởi động

# --- DEBEZIUM ---
DEBEZIUM_IMAGE=quay.io/debezium/connect:2.5 # Image Debezium Kafka Connect (CDC engine)
DEBEZIUM_PORT=8083                          # Port HOST expose REST API ra ngoài (dùng để đăng ký/quản lý connector)
DEBEZIUM_GROUP_ID=retailflow-debezium       # Consumer group ID của Debezium trong Kafka (unique trong cluster)
DEBEZIUM_CONFIG_TOPIC=retailflow.debezium.configs  # Topic lưu cấu hình các connector (cần tạo thủ công trước)
DEBEZIUM_OFFSET_TOPIC=retailflow.debezium.offsets  # Topic lưu offset đã đọc đến đâu trong WAL (quan trọng nhất)
DEBEZIUM_STATUS_TOPIC=retailflow.debezium.status   # Topic lưu trạng thái connector (running/failed/paused)
DEBEZIUM_REPLICATION_FACTOR=1              # Số bản sao 3 topic trên (=1 cho dev single-broker, =3 ở production)

# --- MINIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_IMAGE=minio/minio:latest              # Image MinIO (object storage tương thích S3)
MINIO_API_PORT=9000                         # Port HOST cho S3 API (producer/consumer, Spark đọc ghi data lake)
MINIO_UI_PORT=9001                          # Port HOST cho Web Console (truy cập http://localhost:9001)
MINIO_ROOT_USER=minioadmin                  # Tài khoản admin MinIO (đổi tên mạnh hơn ở production)
MINIO_ROOT_PASSWORD=minioadmin123           # Mật khẩu admin MinIO (tối thiểu 8 ký tự, đổi ở production)

# --- KAFKA UI ---
KAFKA_UI_PORT=8080                          # Port HOST cho Kafka UI Web Console (http://localhost:8080)

# --- CLICKSTREAM BOT ---
KAFKA_BROKER=localhost:9092                 # Kafka broker host:port (từ máy host trỏ vào Docker)
CLICKSTREAM_TOPIC=retailflow_clickstream    # Topic Kafka nhận events clickstream từ bot
CLICKSTREAM_USER_POOL_SIZE=1000            # Số lượng user giả lập (phải tương đồng với dữ liệu PostgreSQL)

# --- SEEDS ---
SEED_PRODUCT_LIMIT=0                       # 0 = không giới hạn (full 13GB CSV). Dùng số nhỏ (vd: 5000) để test nhanh

# --- KAGGLE API ---
# Tạo API key tại: https://www.kaggle.com/settings/account → API → Create New Token
# Dùng để tự động tải dataset từ Kaggle (scripts/ingestion/batch/batch_ingestion_job.py)
KAGGLE_USERNAME=novichristopher
KAGGLE_KEY=KGAT_18d902419ced3f386c5c2f9cc24617c7

# --- TRINO ---
TRINO_PORT=8082                             # Port HOST để truy cập Trino UI (http://localhost:8082)
TRINO_USER=admin                            # Tài khoản (Username) để truy cập Trino UI và chạy query
# =========================================================

# --- APACHE AIRFLOW ---
AIRFLOW_DB_USER=airflow                                 # User đăng nhập DB metadata của Airflow
AIRFLOW_DB_PASSWORD=airflowPassword                     # Mật khẩu DB Airflow (đổi ở production)
AIRFLOW_DB_NAME=airflow                                 # Tên DB metadata của Airflow
AIRFLOW_DB_PORT=5434                                    # Port host (tránh xung đột với Postgres OLTP :5432)
AIRFLOW_ADMIN_USER=admin                                # Tài khoản đăng nhập Airflow Web UI
AIRFLOW_ADMIN_PASSWORD=admin                            # Mật khẩu Airflow Web UI (đổi ở production)
AIRFLOW_WEBSERVER_PORT=8081                             # Port host cho Airflow Web UI (tránh Kafka UI :8080)
# Fernet Key: dùng để mã hóa credentials lưu trong DB. Tạo bằng lệnh:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=j6eTqqgh0gvgFRR4gDvJaDorWW1o-zoUwPDa959P0Ak=
# =========================================================

CLICKSTREAM_MAX_EVENTS=100000
SIMULATION_MAX_HOURS=4