# ============================================================
# .env.docker.example — Template cho Docker Networking
# ============================================================
# Copy file này thành .env.docker khi pull project về.
# Không cần thay đổi gì — các giá trị đã được cấu hình đúng
# cho Docker internal networking.
# ============================================================

KAFKA_BROKER=kafka:29092
MINIO_ENDPOINT=http://minio:9000
DB_HOST=postgres
DB_PORT=5432
