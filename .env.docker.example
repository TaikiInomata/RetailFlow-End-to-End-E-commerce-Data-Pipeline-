# ============================================================
# .env.docker — Docker Networking Overrides
# ============================================================
# File này OVERRIDE các biến networking khi chạy trong Docker.
# Thay "localhost" bằng Docker service name để containers
# giao tiếp nội bộ qua Docker network.
#
# Credentials (passwords, keys) vẫn đọc từ .env gốc.
# docker-compose.yml đọc CẢ HAI file: .env và .env.docker
# ============================================================

# Kafka: bên trong Docker network, dùng internal port 29092
KAFKA_BROKER=kafka:29092

# MinIO: bên trong Docker network, dùng service name thay vì localhost
MINIO_ENDPOINT=http://minio:9000

# PostgreSQL: bên trong Docker network
DB_HOST=postgres
# DB_PORT bên trong Docker dùng port nội bộ 5432 (5433 là external port expose ra host machine)
DB_PORT=5432

# Trino: bên trong Docker network dùng port nội bộ 8080 (8082 là port expose ra host machine)
TRINO_PORT=8080
